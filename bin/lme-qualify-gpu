#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GPU_ID=""
GPU_MEMORY_GB=""
MODEL="gpt-oss:20b"
CONTEXT=32768
QUERY_ID="Q3"
REPEAT=1
CLOUD="SECURE"
FLEET="${LME_RUNPOD_FLEET:-matcher-gptoss-qual}"
MATCHER_REPO="${AF_MATCHER_REPO_PATH:-"$ROOT/../af-matcher-cli"}"
MAX_HOURLY_USD="${RUNPOD_GPU_QUAL_MAX_HOURLY_USD:-1.00}"
MAX_TOTAL_HOURLY_USD="${RUNPOD_MAX_TOTAL_HOURLY_USD:-6.00}"
WATCHDOG_MINUTES="${LME_GPU_QUAL_WATCHDOG_MINUTES:-15}"
LOCAL_OLLAMA_URL="${LOCAL_OLLAMA_URL:-http://127.0.0.1:11434}"
MODEL_DIGEST="${AF_MATCHER_MODEL_DIGEST:-}"
DRY_RUN=0
ASSUME_YES=0

usage() {
  cat <<'USAGE'
Usage:
  bin/lme-qualify-gpu --gpu GPU_ID --vram GB [options]

Qualify exactly one RunPod GPU for the frozen AdventureFinder direct-matcher
workload before considering a multi-worker burst.

Required:
  --gpu GPU_ID               Exact RunPod GPU id, e.g. "NVIDIA GeForce RTX 3090".
  --vram GB                  Minimum VRAM required for this GPU, e.g. 24.

Options:
  --dry-run                  Local validation + read-only RunPod price/availability check.
  --yes                      Skip RunPod's paid-create confirmation.
  --cloud TIER               COMMUNITY or SECURE (default: SECURE).
  --fleet KEY                Named LME fleet (default: matcher-gptoss-qual).
  --matcher-repo PATH        Local af-matcher-cli checkout.
  --digest SHA256            Exact Ollama model digest; otherwise read from local Ollama.
  --max-hourly-usd USD       One-worker hourly safety cap (default: 1.00).
  --max-total-hourly-usd USD Aggregate managed RunPod hourly safety cap (default: 6.00).
  --watchdog-minutes N       Best-effort paid-pod teardown watchdog (default: 15).
  -h, --help                 Show this help.

Frozen workload:
  workers:     1
  model:       gpt-oss:20b
  context:     32768
  matcher:     Q3-R1 only
  sampling:    af-matcher-cli defaults (temperature/seed unset)

Success means:
  - exact requested GPU/model/context bootstrap verification passes;
  - gpt-oss:20b is fully GPU-resident;
  - Q3-R1 completes successfully; and
  - post-request /api/ps still reports size == size_vram and context 32768.

The command records measured throughput but deliberately does not impose an
unvalidated tokens/sec threshold.
USAGE
}

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
info() { printf '[gpu-qual] %s\n' "$*"; }

while (($#)); do
  case "$1" in
    --gpu)
      [[ $# -ge 2 ]] || die "--gpu requires a value"
      GPU_ID="$2"
      shift 2
      ;;
    --vram)
      [[ $# -ge 2 ]] || die "--vram requires a value"
      GPU_MEMORY_GB="$2"
      shift 2
      ;;
    --dry-run) DRY_RUN=1; shift ;;
    --yes) ASSUME_YES=1; shift ;;
    --cloud)
      [[ $# -ge 2 ]] || die "--cloud requires a value"
      CLOUD="$(printf '%s' "$2" | tr '[:lower:]' '[:upper:]')"
      shift 2
      ;;
    --fleet)
      [[ $# -ge 2 ]] || die "--fleet requires a value"
      FLEET="$2"
      shift 2
      ;;
    --matcher-repo)
      [[ $# -ge 2 ]] || die "--matcher-repo requires a path"
      MATCHER_REPO="$2"
      shift 2
      ;;
    --digest)
      [[ $# -ge 2 ]] || die "--digest requires a SHA-256"
      MODEL_DIGEST="$2"
      shift 2
      ;;
    --max-hourly-usd)
      [[ $# -ge 2 ]] || die "--max-hourly-usd requires a value"
      MAX_HOURLY_USD="$2"
      shift 2
      ;;
    --max-total-hourly-usd)
      [[ $# -ge 2 ]] || die "--max-total-hourly-usd requires a value"
      MAX_TOTAL_HOURLY_USD="$2"
      shift 2
      ;;
    --watchdog-minutes)
      [[ $# -ge 2 ]] || die "--watchdog-minutes requires an integer"
      WATCHDOG_MINUTES="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ -n "$GPU_ID" ]] || { usage >&2; die "--gpu is required"; }
[[ "$GPU_MEMORY_GB" =~ ^[1-9][0-9]*$ ]] || { usage >&2; die "--vram must be a positive integer"; }
[[ "$CLOUD" == "COMMUNITY" || "$CLOUD" == "SECURE" ]] || die "--cloud must be COMMUNITY or SECURE"
[[ "$WATCHDOG_MINUTES" =~ ^[1-9][0-9]*$ ]] || die "--watchdog-minutes must be a positive integer"
[[ -d "$MATCHER_REPO" ]] || die "af-matcher-cli checkout not found: $MATCHER_REPO"
[[ -x "$MATCHER_REPO/bin/af-matcher" ]] || die "missing executable: $MATCHER_REPO/bin/af-matcher"
[[ -x "$MATCHER_REPO/bin/test" ]] || die "missing executable: $MATCHER_REPO/bin/test"
command -v ruby >/dev/null 2>&1 || die "ruby is required"
command -v bundle >/dev/null 2>&1 || die "bundler is required"
command -v curl >/dev/null 2>&1 || die "curl is required"
command -v git >/dev/null 2>&1 || die "git is required"
command -v zip >/dev/null 2>&1 || die "zip is required"

GPU_SLUG="$(
  printf '%s' "$GPU_ID" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//'
)"
[[ -n "$GPU_SLUG" ]] || die "could not derive output slug from --gpu"

info "Local preflight: af-matcher-cli tests and run-case support"
(
  cd "$MATCHER_REPO"
  bundle check >/dev/null
  bin/test
  bin/af-matcher help | grep -q "run-case"
)

if [[ -z "$MODEL_DIGEST" ]]; then
  info "Reading exact $MODEL digest from local Ollama at $LOCAL_OLLAMA_URL"
  tags="$(curl -fsS "${LOCAL_OLLAMA_URL%/}/api/tags")" || \
    die "cannot read local Ollama tags; start Ollama or pass --digest"
  MODEL_DIGEST="$(
    printf '%s' "$tags" | ruby -rjson -e '
      model = ARGV.fetch(0)
      rows = Array(JSON.parse(STDIN.read)["models"])
      row = rows.find do |r|
        [r["name"], r["model"]].compact.any? do |name|
          name == model || name.sub(/:latest\z/, "") == model.sub(/:latest\z/, "")
        end
      end
      print(row && row["digest"].to_s)
    ' "$MODEL"
  )"
fi
[[ "$MODEL_DIGEST" =~ ^[0-9a-fA-F]{64}$ ]] || die "model digest must be exactly 64 hexadecimal characters"

MATCHER_SHA="$(git -C "$MATCHER_REPO" rev-parse HEAD)"
LME_SHA="$(git -C "$ROOT" rev-parse HEAD)"

info "Frozen qualification:"
info "  gpu=$GPU_ID min_vram=${GPU_MEMORY_GB}GB"
info "  model=$MODEL digest=$MODEL_DIGEST"
info "  context=$CONTEXT case=${QUERY_ID}:$REPEAT"
info "  cloud=$CLOUD fleet=$FLEET"
info "  matcher=$MATCHER_REPO @ $MATCHER_SHA"

GPU_ENV=(
  env
  "RUNPOD_GPU_ID=$GPU_ID"
  "RUNPOD_GPU_MEMORY_GB=$GPU_MEMORY_GB"
  "LME_RUNPOD_FLEET=$FLEET"
)

create_args=(
  runpod-create
  --workers 1
  --cloud "$CLOUD"
  --max-hourly-usd "$MAX_HOURLY_USD"
  --max-total-hourly-usd "$MAX_TOTAL_HOURLY_USD"
)

if ((DRY_RUN)); then
  info "Read-only GPU qualification preflight; no pod will be created."
  "${GPU_ENV[@]}" "$ROOT/bin/lme" "${create_args[@]}" --dry-run
  exit 0
fi

if ((ASSUME_YES)); then
  create_args+=(--yes)
fi

STAMP="$(date -u '+%Y%m%dT%H%M%SZ')"
RUN_ROOT="$ROOT/output/gpu-qualification/${STAMP}__${GPU_SLUG}__gpt-oss_20b"
mkdir -p "$RUN_ROOT"
FLEET_CREATED=0
TUNNEL_STARTED=0
WATCHDOG_PID=""

cleanup() {
  rc=$?
  trap - EXIT INT TERM

  if [[ -n "$WATCHDOG_PID" ]]; then
    kill "$WATCHDOG_PID" 2>/dev/null || true
    wait "$WATCHDOG_PID" 2>/dev/null || true
  fi

  if ((TUNNEL_STARTED)); then
    info "Stopping qualification tunnel ..."
    "${GPU_ENV[@]}" "$ROOT/bin/lme" runpod-tunnels stop --workers 1 \
      >"$RUN_ROOT/tunnels-stop.log" 2>&1 || true
  fi

  if ((FLEET_CREATED)); then
    info "Destroying paid qualification pod ..."
    if "${GPU_ENV[@]}" "$ROOT/bin/lme" runpod-destroy --workers 1 --yes \
      >"$RUN_ROOT/runpod-destroy.log" 2>&1; then
      printf 'teardown_finished_at_utc=%s\n' "$(date -u '+%Y%m%dT%H%M%SZ')" >>"$RUN_ROOT/timing.env"
    else
      cat "$RUN_ROOT/runpod-destroy.log" >&2 || true
      printf 'WARNING: automatic teardown failed; run manually:\n' >&2
      printf "  RUNPOD_GPU_ID=%q RUNPOD_GPU_MEMORY_GB=%q LME_RUNPOD_FLEET=%q %q runpod-destroy --workers 1 --yes\n" \
        "$GPU_ID" "$GPU_MEMORY_GB" "$FLEET" "$ROOT/bin/lme" >&2
      [[ $rc -ne 0 ]] || rc=1
    fi
  fi

  if [[ -d "$RUN_ROOT" ]]; then
    printf 'GPU qualification artifacts: %s\n' "$RUN_ROOT"
    [[ -f "${RUN_ROOT}.zip" ]] && printf 'GPU qualification ZIP: %s\n' "${RUN_ROOT}.zip"
  fi
  exit "$rc"
}
trap cleanup EXIT INT TERM

printf 'driver_started_at_utc=%s\n' "$(date -u '+%Y%m%dT%H%M%SZ')" >"$RUN_ROOT/timing.env"
cat >"$RUN_ROOT/provenance.txt" <<EOF
created_at_utc=$STAMP
gpu_id=$GPU_ID
gpu_memory_min_gb=$GPU_MEMORY_GB
model=$MODEL
model_digest=$MODEL_DIGEST
context_length=$CONTEXT
query_id=$QUERY_ID
repeat=$REPEAT
cloud=$CLOUD
fleet=$FLEET
max_hourly_usd=$MAX_HOURLY_USD
max_total_hourly_usd=$MAX_TOTAL_HOURLY_USD
watchdog_minutes=$WATCHDOG_MINUTES
matcher_repo=$MATCHER_REPO
matcher_git_sha=$MATCHER_SHA
lme_git_sha=$LME_SHA
EOF

info "Creating one paid $GPU_ID qualification pod ..."
"${GPU_ENV[@]}" "$ROOT/bin/lme" "${create_args[@]}" | tee "$RUN_ROOT/create.log"
FLEET_CREATED=1
printf 'fleet_ready_at_utc=%s\n' "$(date -u '+%Y%m%dT%H%M%SZ')" >>"$RUN_ROOT/timing.env"

(
  sleep "$((WATCHDOG_MINUTES * 60))"
  printf '[gpu-qual] WATCHDOG: %s minutes elapsed; destroying paid qualification pod.\n' \
    "$WATCHDOG_MINUTES" >&2
  "${GPU_ENV[@]}" "$ROOT/bin/lme" runpod-destroy --workers 1 --yes \
    >"$RUN_ROOT/watchdog-teardown.log" 2>&1 || true
) &
WATCHDOG_PID=$!

info "Bootstrapping $MODEL at $CONTEXT context and verifying GPU residency ..."
"${GPU_ENV[@]}" "$ROOT/bin/lme" runpod-bootstrap \
  --workers 1 \
  --model "$MODEL" \
  --expect-digest "$MODEL=$MODEL_DIGEST" \
  --context "$CONTEXT" \
  --clean | tee "$RUN_ROOT/bootstrap.log"
printf 'bootstrap_finished_at_utc=%s\n' "$(date -u '+%Y%m%dT%H%M%SZ')" >>"$RUN_ROOT/timing.env"

info "Opening local Ollama tunnel ..."
"${GPU_ENV[@]}" "$ROOT/bin/lme" runpod-tunnels start --workers 1 | tee "$RUN_ROOT/tunnels-start.log"
TUNNEL_STARTED=1

JOBS_PATH="$RUN_ROOT/jobs.json"
CAPABILITY_PATH="$RUN_ROOT/capability.json"
DISPATCH_ROOT="$RUN_ROOT/dispatch"
MATCHER_OUTPUT="$RUN_ROOT/matcher"

ruby -rjson -e '
  matcher_repo, model, context, query_id, repeat, matcher_output, ps_output, qualification_summary, gpu_id, gpu_memory = ARGV
  job = {
    "job_id" => "gpu-qualification",
    "argv" => ["bin/lme-matcher-remote-job", query_id, repeat],
    "env" => {
      "AF_MATCHER_REPO_PATH" => matcher_repo,
      "AF_MATCHER_MODEL" => model,
      "AF_MATCHER_REPEATS" => "2",
      "AF_MATCHER_NUM_CTX" => context,
      "AF_MATCHER_TEMPERATURE" => "",
      "AF_MATCHER_SEED" => "",
      "AF_MATCHER_OUTPUT_ROOT" => matcher_output,
      "LME_MATCHER_VERIFY_RESIDENCY" => "true",
      "LME_MATCHER_PS_OUTPUT" => ps_output,
      "LME_MATCHER_QUALIFICATION_SUMMARY" => qualification_summary,
      "RUNPOD_GPU_ID" => gpu_id,
      "RUNPOD_GPU_MEMORY_GB" => gpu_memory
    }
  }
  puts JSON.pretty_generate("jobs" => [job])
' "$MATCHER_REPO" "$MODEL" "$CONTEXT" "$QUERY_ID" "$REPEAT" \
  "$MATCHER_OUTPUT" "$RUN_ROOT/api-ps-after-case.json" "$RUN_ROOT/qualification-summary.txt" \
  "$GPU_ID" "$GPU_MEMORY_GB" >"$JOBS_PATH"

info "Running representative matcher case through the versioned RPOF capability/dispatch boundary ..."
"${GPU_ENV[@]}" "$ROOT/bin/lme-rpof-campaign" \
  --workers 1 \
  --model "$MODEL" \
  --expect-digest "$MODEL=$MODEL_DIGEST" \
  --context "$CONTEXT" \
  --gpu "$GPU_ID" \
  --jobs "$JOBS_PATH" \
  --workdir "$ROOT" \
  --output "$DISPATCH_ROOT" \
  --capability-output "$CAPABILITY_PATH"
printf 'matcher_finished_at_utc=%s\n' "$(date -u '+%Y%m%dT%H%M%SZ')" >>"$RUN_ROOT/timing.env"

[[ -f "$RUN_ROOT/qualification-summary.txt" ]] || die "qualification summary was not produced"
cat "$RUN_ROOT/qualification-summary.txt"

info "Qualification PASS; destroying paid pod before packaging artifacts."
"${GPU_ENV[@]}" "$ROOT/bin/lme" runpod-tunnels stop --workers 1 | tee "$RUN_ROOT/tunnels-stop.log"
TUNNEL_STARTED=0

"${GPU_ENV[@]}" "$ROOT/bin/lme" runpod-destroy --workers 1 --yes | tee "$RUN_ROOT/runpod-destroy.log"
FLEET_CREATED=0
printf 'teardown_finished_at_utc=%s\n' "$(date -u '+%Y%m%dT%H%M%SZ')" >>"$RUN_ROOT/timing.env"

kill "$WATCHDOG_PID" 2>/dev/null || true
wait "$WATCHDOG_PID" 2>/dev/null || true
WATCHDOG_PID=""

(
  cd "$(dirname "$RUN_ROOT")"
  zip -qr "$(basename "$RUN_ROOT").zip" "$(basename "$RUN_ROOT")"
)

info "GPU qualification complete and paid pod destroyed."
