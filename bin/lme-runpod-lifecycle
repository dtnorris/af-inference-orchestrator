#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"

root = File.expand_path("..", __dir__)
command = ARGV.shift
unless %w[scale replace].include?(command)
  warn "Usage: bin/lme-runpod-lifecycle (scale|replace) [options]"
  exit 2
end

exec RbConfig.ruby, File.join(root, "bin", "lme-rpof"), command, *ARGV
