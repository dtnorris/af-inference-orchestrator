#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

ROOT = File.expand_path(ENV.fetch("LME_REPO", File.expand_path("..", __dir__)))
ENV["LME_REPO"] = ROOT
$LOAD_PATH.unshift File.join(ROOT, "lib")
require "production_burst_runner"

opts = {
  output: nil,
  dry_run: false,
  yes: false,
  keep_fleets: false
}
parser = OptionParser.new do |o|
  o.banner = "Usage: bin/lme-production-burst PLAN.json --output DIR (--dry-run|--yes) [--keep-fleets]"
  o.on("--output DIR", "Parent production-burst evidence directory") { |v| opts[:output] = v }
  o.on("--dry-run", "Plan all pool fulfillments; create no paid resources or scoring campaigns") { opts[:dry_run] = true }
  o.on("--yes", "Authorize this exact plan within its frozen pool/aggregate cost ceilings") { opts[:yes] = true }
  o.on("--keep-fleets", "Do not arm child campaign terminal shutdown gates") { opts[:keep_fleets] = true }
end

begin
  parser.parse!(ARGV)
  plan_arg = ARGV.shift
  raise OptionParser::MissingArgument, "PLAN.json" unless plan_arg
  raise OptionParser::MissingArgument, "--output" unless opts[:output]
  raise OptionParser::InvalidArgument, "--dry-run and --yes are mutually exclusive" if opts[:dry_run] && opts[:yes]
  raise OptionParser::InvalidArgument, "use --dry-run or --yes" unless opts[:dry_run] || opts[:yes]
  raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
rescue OptionParser::ParseError => e
  warn "ERROR: #{e.message}"
  warn parser
  exit 2
end

begin
  result = ProductionBurstRunner.new(root: ROOT).run(
    plan: plan_arg,
    output: opts.fetch(:output),
    dry_run: opts.fetch(:dry_run),
    keep_fleets: opts.fetch(:keep_fleets)
  )
  exit result.exit_status
rescue Interrupt
  warn "Interrupted."
  exit 130
rescue ProductionBurstRunner::Error => e
  warn "ERROR: #{e.message}"
  exit 1
end
