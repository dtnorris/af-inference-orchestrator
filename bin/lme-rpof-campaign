#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "optparse"

ROOT = File.expand_path(ENV.fetch("LME_REPO", File.expand_path("..", __dir__)))
ENV["LME_REPO"] = ROOT
$LOAD_PATH.unshift File.join(ROOT, "lib")
require "local_model_evaluation/production_backlog_source_preflight"
require "local_model_evaluation/rpof_client"
require "production_worker_expansion_controller"

opts = {
  workers: nil,
  all: false,
  fleet: ENV.fetch("LME_RUNPOD_FLEET", "default"),
  models: [],
  expected_digests: {},
  context: nil,
  gpu: nil,
  jobs: nil,
  workdir: nil,
  output: nil,
  capability_output: nil,
  source_preflight_queue: nil,
  group_by_affinity: false,
  dynamic_worker_admission: false,
  expansion_plan: nil,
  expansion_pool: nil,
  initial_fulfillment_seconds: nil,
  keep_fleet: false,
  terminal_inactivity_minutes: 5.0,
  shutdown_drain_timeout_minutes: 10.0
}
parser = OptionParser.new do |o|
  o.banner = "Usage: bin/lme-rpof-campaign --jobs FILE --workdir DIR --output DIR (--workers LIST|--all) --model NAME --context N [options]"
  o.on("--workers LIST", "Logical worker indices, e.g. 1-8 or 1,4,8") { |v| opts[:workers] = v }
  o.on("--all", "Use every active worker in the logical fleet") { opts[:all] = true }
  o.on("--fleet KEY", "Logical RPOF fleet key") { |v| opts[:fleet] = v }
  o.on("--model NAME", "Required Ollama model; repeat for multiple models") { |v| opts[:models] << v }
  o.on("--expect-digest MODEL=SHA256", "Require an exact model digest") do |v|
    name, digest = v.split("=", 2)
    raise OptionParser::InvalidArgument, "--expect-digest must be MODEL=SHA256" if name.to_s.empty? || !digest.to_s.match?(/\A[0-9a-fA-F]{64}\z/)
    opts[:expected_digests][name] = digest.downcase
  end
  o.on("--context N", Integer, "Required Ollama context length") { |v| opts[:context] = v }
  o.on("--gpu ID", "Optional exact required GPU id") { |v| opts[:gpu] = v }
  o.on("--jobs FILE", "JSON document containing a jobs array") { |v| opts[:jobs] = v }
  o.on("--workdir DIR", "Opaque RPOF workload working directory") { |v| opts[:workdir] = v }
  o.on("--output DIR", "RPOF generic dispatch evidence directory") { |v| opts[:output] = v }
  o.on("--capability-output FILE", "Persist the generic capability result") { |v| opts[:capability_output] = v }
  o.on("--source-preflight-queue QUEUE", "Frozen production queue used to source-preflight selected production jobs") { |v| opts[:source_preflight_queue] = v }
  o.on("--group-by-affinity", "Request stable generic affinity grouping") { opts[:group_by_affinity] = true }
  o.on("--dynamic-worker-admission", "Allow prepared workers to join this dispatch while jobs remain unclaimed") { opts[:dynamic_worker_admission] = true }
  o.on("--expansion-plan FILE", "Frozen execution-pool plan used for adaptive worker expansion") { |v| opts[:expansion_plan] = v }
  o.on("--expansion-pool POOL", "Pool id within --expansion-plan") { |v| opts[:expansion_pool] = v }
  o.on("--initial-fulfillment-seconds N", Float, "Measured starter fulfillment wall time used to estimate another worker bootstrap") { |v| opts[:initial_fulfillment_seconds] = v }
  o.on("--keep-fleet", "Do not arm the default post-campaign terminal shutdown gate") { opts[:keep_fleet] = true }
  o.on("--terminal-inactivity-minutes MINUTES", Float, "Continuous inactivity window before automatic shutdown (default: 5)") { |v| opts[:terminal_inactivity_minutes] = v }
  o.on("--shutdown-drain-timeout-minutes MINUTES", Float, "Maximum graceful drain wait after terminal gate fires (default: 10)") { |v| opts[:shutdown_drain_timeout_minutes] = v }
end

begin
  parser.parse!(ARGV)
  raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
  raise OptionParser::InvalidArgument, "use either --workers or --all, not both" if opts[:workers] && opts[:all]
  raise OptionParser::InvalidArgument, "use --workers LIST or --all" unless opts[:workers] || opts[:all]
  %i[context jobs workdir output].each do |key|
    raise OptionParser::MissingArgument, "--#{key.to_s.tr('_', '-')}" if opts[key].nil?
  end
  raise OptionParser::InvalidArgument, "--context must be positive" unless opts[:context].positive?
  raise OptionParser::MissingArgument, "--model" if opts[:models].empty?
  raise OptionParser::InvalidArgument, "--terminal-inactivity-minutes must be positive" unless opts[:terminal_inactivity_minutes].positive?
  raise OptionParser::InvalidArgument, "--shutdown-drain-timeout-minutes must be positive" unless opts[:shutdown_drain_timeout_minutes].positive?
  unknown_digests = opts[:expected_digests].keys - opts[:models]
  raise OptionParser::InvalidArgument, "digest supplied for unrequested model(s): #{unknown_digests.join(', ')}" unless unknown_digests.empty?
  expansion_values = [opts[:expansion_plan], opts[:expansion_pool], opts[:initial_fulfillment_seconds]]
  if expansion_values.any? && !expansion_values.all?
    raise OptionParser::InvalidArgument,
          "--expansion-plan, --expansion-pool, and --initial-fulfillment-seconds must be used together"
  end
  if opts[:initial_fulfillment_seconds] && opts[:initial_fulfillment_seconds] <= 0
    raise OptionParser::InvalidArgument, "--initial-fulfillment-seconds must be positive"
  end
  if opts[:expansion_plan] && !opts[:dynamic_worker_admission]
    raise OptionParser::InvalidArgument, "adaptive expansion requires --dynamic-worker-admission"
  end
rescue OptionParser::ParseError => e
  warn "ERROR: #{e.message}"
  warn parser
  exit 2
end

def write_atomic(path, content)
  expanded = File.expand_path(path)
  FileUtils.mkdir_p(File.dirname(expanded))
  tmp = "#{expanded}.tmp.#{$$}"
  File.write(tmp, content)
  File.rename(tmp, expanded)
ensure
  File.delete(tmp) if defined?(tmp) && tmp && File.exist?(tmp)
end

def shutdown_workers(summary_or_path, fallback)
  summary = if summary_or_path.is_a?(Hash)
              summary_or_path
            elsif File.file?(summary_or_path.to_s)
              JSON.parse(File.read(summary_or_path.to_s))
            end
  values = summary && Array(summary["worker_indices"])
  indices = values&.map { |value| Integer(value) }&.uniq&.sort
  indices && !indices.empty? ? indices : Array(fallback).map { |value| Integer(value) }.uniq.sort
rescue JSON::ParserError, ArgumentError, TypeError
  Array(fallback).map { |value| Integer(value) }.uniq.sort
end

begin
  jobs_document = JSON.parse(File.read(File.expand_path(opts.fetch(:jobs))))
  jobs = jobs_document.fetch("jobs")
  raise ArgumentError, "jobs must be a non-empty array" unless jobs.is_a?(Array) && !jobs.empty?
  production_manifests = jobs.filter_map do |job|
    argv = job["argv"]
    next unless argv.is_a?(Array) && argv.first.to_s == "bin/lme-production-remote-job"

    unless argv.length == 2 && !argv.fetch(1).to_s.empty?
      raise ArgumentError,
            "production remote campaign job #{job.fetch('job_id', '?')} must use argv " \
            "[\"bin/lme-production-remote-job\", MANIFEST]"
    end
    argv.fetch(1).to_s
  end
  if production_manifests.any? && opts[:source_preflight_queue].to_s.empty?
    raise ArgumentError, "production remote campaign jobs require --source-preflight-queue QUEUE"
  end
  if opts[:source_preflight_queue] && production_manifests.empty?
    raise ArgumentError,
          "--source-preflight-queue requires at least one bin/lme-production-remote-job job"
  end

  selector = if opts[:all]
               { "mode" => "all" }
             else
               {
                 "mode" => "indices",
                 "indices" => LocalModelEvaluation::RpofClient.expand_worker_selector(opts.fetch(:workers))
               }
             end
  models = opts[:models].uniq.map do |name|
    row = { "name" => name }
    row["expected_digest"] = opts[:expected_digests][name] if opts[:expected_digests].key?(name)
    row
  end
  capability_contract = if models.all? { |row| row.key?("expected_digest") }
                          "afio-rpof-capability-check-request/v0.2"
                        else
                          "afio-rpof-capability-check-request/v0.1"
                        end
  requirements = {
    "models" => models,
    "required_context_length" => opts.fetch(:context),
    "require_fully_gpu_resident" => true
  }
  requirements["required_gpu_id"] = opts[:gpu] if opts[:gpu]

  client = LocalModelEvaluation::RpofClient.new(repo_root: ROOT)
  capability = client.capability_check(
    "contract_version" => capability_contract,
    "fleet_key" => opts.fetch(:fleet),
    "worker_selector" => selector,
    "requirements" => requirements
  )
  capability_path = opts[:capability_output] || "#{File.expand_path(opts.fetch(:output))}.capability.json"
  write_atomic(capability_path, JSON.pretty_generate(capability) + "\n")

  unless capability.fetch("ready")
    failures = capability.fetch("diagnostics").select { |row| row["status"] == "FAIL" }
    warn "ERROR: RPOF capability check failed: #{failures.map { |row| "#{row['code']}: #{row['detail']}" }.join('; ')}"
    exit 1
  end

  selected_workers = capability.fetch("selected_worker_indices")
  worker_labels = selected_workers.map { |index| "burst_#{index}" }.join(", ")
  puts "RPOF capability check: PASS — fleet #{capability.fetch('fleet_id')}; workers #{worker_labels}"
  $stdout.flush

  unless production_manifests.empty?
    puts "Source preflight: #{production_manifests.length} selected production manifest(s) from #{opts.fetch(:source_preflight_queue)}"
    source_ready = LocalModelEvaluation::ProductionBacklogSourcePreflight.new(root: ROOT).run(
      opts.fetch(:source_preflight_queue),
      manifest_entries: production_manifests
    )
    unless source_ready
      warn "ERROR: selected production source preflight failed; no dispatch was started."
      exit 1
    end
  end

  puts "RPOF dispatch starting: #{jobs.length} jobs across #{selected_workers.length} worker(s)"
  puts "RPOF dispatch evidence: #{File.expand_path(opts.fetch(:output))}"
  $stdout.flush

  dispatch_request = {
    "contract_version" => "afio-rpof-dispatch-request/v0.1",
    "target" => {
      "fleet_key" => opts.fetch(:fleet),
      "expected_fleet_id" => capability.fetch("fleet_id"),
      "worker_indices" => selected_workers
    },
    "group_by_affinity" => opts.fetch(:group_by_affinity),
    "jobs" => jobs
  }
  dispatch_running = true
  expansion_error = nil
  expansion_thread = if opts[:expansion_plan]
                       Thread.new do
                         begin
                           ProductionWorkerExpansionController.new(
                             root: ROOT,
                             rpof_client: client,
                             out: $stdout
                           ).run(
                             plan_path: opts.fetch(:expansion_plan),
                             pool_id: opts.fetch(:expansion_pool),
                             execution_handle: opts.fetch(:fleet),
                             output_dir: opts.fetch(:output),
                             initial_worker_indices: selected_workers,
                             initial_fulfillment_seconds: opts.fetch(:initial_fulfillment_seconds),
                             dispatch_alive: -> { dispatch_running }
                           )
                         rescue ProductionWorkerExpansionController::Error => e
                           expansion_error = e
                         end
                       end
                     end
  begin
    summary, _rpof_exit, stdout, stderr = client.dispatch(
      request: dispatch_request,
      workdir: opts.fetch(:workdir),
      output_dir: opts.fetch(:output),
      stream_output: true,
      dynamic_worker_admission: opts.fetch(:dynamic_worker_admission)
    )
  rescue Interrupt
    dispatch_running = false
    expansion_thread&.join
    unless opts.fetch(:keep_fleet)
      begin
        indices = shutdown_workers(
          File.join(File.expand_path(opts.fetch(:output)), "summary.json"), selected_workers
        )
        handoff = client.terminal_shutdown(
          fleet_key: opts.fetch(:fleet),
          worker_indices: indices,
          inactivity_minutes: opts.fetch(:terminal_inactivity_minutes),
          drain_timeout_minutes: opts.fetch(:shutdown_drain_timeout_minutes),
          reason: "afio_campaign_interrupted"
        )
        warn "RPOF terminal gate after interrupt: #{handoff}" unless handoff.empty?
      rescue LocalModelEvaluation::RpofClient::Error => e
        warn "WARNING: could not arm RPOF terminal gate after interrupt: #{e.message}"
      end
    end
    raise
  ensure
    dispatch_running = false
    expansion_thread&.join
  end
  warn "WARNING: adaptive worker expansion stopped: #{expansion_error.message}" if expansion_error
  $stdout.write(stdout) unless stdout.empty?
  $stderr.write(stderr) unless stderr.empty?
  puts "RPOF campaign: #{summary.fetch('status')} (#{summary.fetch('completed_count')}/#{summary.fetch('job_count')} completed)"

  unless opts.fetch(:keep_fleet)
    indices = shutdown_workers(summary, selected_workers)
    handoff = client.terminal_shutdown(
      fleet_key: opts.fetch(:fleet),
      worker_indices: indices,
      inactivity_minutes: opts.fetch(:terminal_inactivity_minutes),
      drain_timeout_minutes: opts.fetch(:shutdown_drain_timeout_minutes),
      reason: "afio_campaign_#{summary.fetch('status')}"
    )
    puts "RPOF terminal gate: #{handoff}" unless handoff.empty?
  else
    puts "RPOF terminal gate: skipped by --keep-fleet"
  end

  case summary.fetch("status")
  when "completed" then exit 0
  when "workload_failed" then exit 2
  else exit 1
  end
rescue JSON::ParserError, KeyError, ArgumentError, TypeError, SystemCallError,
       LocalModelEvaluation::RpofClient::Error => e
  warn "ERROR: RPOF campaign bridge failed: #{e.message}"
  exit 1
end
