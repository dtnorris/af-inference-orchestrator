#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "production_backlog_runner_policy"

command = ARGV.shift
case command
when "route"
  snapshot = ARGV.shift or abort "Usage: production-backlog-policy route SNAPSHOT.yml"
  contract_type = ProductionBacklogRunnerPolicy.contract_type_from_snapshot(snapshot)
  print "#{contract_type}\t#{ProductionBacklogRunnerPolicy.verifier_for(contract_type)}"
when "max-tokens"
  contract_type = ARGV.shift or abort "Usage: production-backlog-policy max-tokens CONTRACT_TYPE MANIFEST.yml"
  manifest = ARGV.shift or abort "Usage: production-backlog-policy max-tokens CONTRACT_TYPE MANIFEST.yml"
  value = ProductionBacklogRunnerPolicy.runtime_max_tokens_for_file(
    contract_type:,
    manifest_path: manifest
  )
  print value if value
when "status"
  manifest = ARGV.shift or abort "Usage: production-backlog-policy status MANIFEST.yml OUTPUT_ROOT"
  output_root = ARGV.shift or abort "Usage: production-backlog-policy status MANIFEST.yml OUTPUT_ROOT"
  print ProductionBacklogRunnerPolicy.manifest_status_for_file(manifest_path: manifest, output_root:)
when "inspect"
  contract_type = ARGV.shift or abort "Usage: production-backlog-policy inspect CONTRACT_TYPE MANIFEST.yml OUTPUT_ROOT"
  manifest = ARGV.shift or abort "Usage: production-backlog-policy inspect CONTRACT_TYPE MANIFEST.yml OUTPUT_ROOT"
  output_root = ARGV.shift or abort "Usage: production-backlog-policy inspect CONTRACT_TYPE MANIFEST.yml OUTPUT_ROOT"
  status, max_tokens = ProductionBacklogRunnerPolicy.inspect_manifest_file(
    contract_type:,
    manifest_path: manifest,
    output_root:
  )
  print "#{status}\t#{max_tokens}"
else
  abort "Usage: production-backlog-policy (route SNAPSHOT.yml|max-tokens CONTRACT_TYPE MANIFEST.yml|status MANIFEST.yml OUTPUT_ROOT|inspect CONTRACT_TYPE MANIFEST.yml OUTPUT_ROOT)"
end
