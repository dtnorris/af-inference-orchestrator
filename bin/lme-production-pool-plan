#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "optparse"

ROOT = File.expand_path(ENV.fetch("LME_REPO", File.expand_path("..", __dir__)))
$LOAD_PATH.unshift File.join(ROOT, "lib")
require "production_execution_pool_plan"
require "production_execution_pool_plan_writer"

opts = {
  policy: File.join("config", "production_execution_pools.yml"),
  models: File.join("config", "models.yml"),
  output: nil,
  desired_workers: {},
  minimum_workers: {},
  max_pool_hourly_usd: {},
  max_total_hourly_usd: nil,
  context: nil,
  budget_id: nil,
  max_cumulative_compute_usd: nil,
  max_runtime_seconds: nil,
  guardian_poll_seconds: nil,
  orchestrator_heartbeat_timeout_seconds: nil,
  teardown_reserve_seconds: nil
}

parse_assignment = lambda do |value, label, numeric:|
  key, raw = value.to_s.split("=", 2)
  if key.to_s.empty? || raw.to_s.empty?
    raise OptionParser::InvalidArgument, "#{label} must use POOL=VALUE"
  end
  parsed = numeric.call(raw)
  [key, parsed]
rescue ArgumentError, TypeError
  raise OptionParser::InvalidArgument, "invalid #{label}: #{value.inspect}"
end

parser = OptionParser.new do |o|
  o.banner = "Usage: bin/lme-production-pool-plan QUEUE --output PATH [options]"
  o.on("--policy PATH", "Execution-pool policy config") { |v| opts[:policy] = v }
  o.on("--models PATH", "Qualified model config") { |v| opts[:models] = v }
  o.on("--output PATH", "Write deterministic execution-pool plan JSON") { |v| opts[:output] = v }
  o.on("--workers POOL=N", "Override desired worker count; repeatable") do |v|
    key, value = parse_assignment.call(v, "--workers", numeric: ->(raw) { Integer(raw) })
    opts[:desired_workers][key] = value
  end
  o.on("--minimum-workers POOL=N", "Override minimum useful worker count; repeatable") do |v|
    key, value = parse_assignment.call(v, "--minimum-workers", numeric: ->(raw) { Integer(raw) })
    opts[:minimum_workers][key] = value
  end
  o.on("--max-pool-hourly-usd POOL=USD", "Override pool hourly safety ceiling; repeatable") do |v|
    key, value = parse_assignment.call(v, "--max-pool-hourly-usd", numeric: ->(raw) { Float(raw) })
    opts[:max_pool_hourly_usd][key] = value
  end
  o.on("--max-total-hourly-usd USD", Float, "Override aggregate execution-pool hourly ceiling") do |v|
    opts[:max_total_hourly_usd] = v
  end
  o.on("--budget-id ID", "Opaque immutable production-burst budget id") { |v| opts[:budget_id] = v }
  o.on("--max-cumulative-compute-usd USD", Float, "Override cumulative compute-dollar ceiling") { |v| opts[:max_cumulative_compute_usd] = v }
  o.on("--max-runtime-seconds N", Float, "Override production-burst maximum runtime") { |v| opts[:max_runtime_seconds] = v }
  o.on("--guardian-poll-seconds N", Float, "Override guardian polling cadence") { |v| opts[:guardian_poll_seconds] = v }
  o.on("--orchestrator-heartbeat-timeout-seconds N", Float, "Override AFIO heartbeat timeout") { |v| opts[:orchestrator_heartbeat_timeout_seconds] = v }
  o.on("--teardown-reserve-seconds N", Float, "Override teardown reserve duration") { |v| opts[:teardown_reserve_seconds] = v }
  o.on("--context N", Integer, "Override required Ollama context length") { |v| opts[:context] = v }
end

begin
  parser.parse!(ARGV)
  queue = ARGV.shift
  raise OptionParser::MissingArgument, "QUEUE" unless queue
  raise OptionParser::MissingArgument, "--output" unless opts[:output]
  raise OptionParser::MissingArgument, "--budget-id" if opts[:budget_id].to_s.strip.empty?
  raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
rescue OptionParser::ParseError => e
  warn "ERROR: #{e.message}"
  warn parser
  exit 2
end

begin
  planner = ProductionExecutionPoolPlan.new(
    root: ROOT,
    model_config_path: opts[:models],
    policy_path: opts[:policy]
  )
  plan = planner.build(
    queue_path: queue,
    budget_id: opts.fetch(:budget_id),
    desired_workers: opts[:desired_workers],
    minimum_workers: opts[:minimum_workers],
    max_pool_hourly_usd: opts[:max_pool_hourly_usd],
    max_total_hourly_usd: opts[:max_total_hourly_usd],
    required_context_length: opts[:context],
    max_cumulative_compute_usd: opts[:max_cumulative_compute_usd],
    max_runtime_seconds: opts[:max_runtime_seconds],
    guardian_poll_seconds: opts[:guardian_poll_seconds],
    orchestrator_heartbeat_timeout_seconds: opts[:orchestrator_heartbeat_timeout_seconds],
    teardown_reserve_seconds: opts[:teardown_reserve_seconds]
  )

  output_path = ProductionExecutionPoolPlanWriter.new(root: ROOT).write(
    plan:,
    output: opts.fetch(:output)
  )

  puts "AFIO production execution-pool plan"
  puts "  Queue: #{plan.dig('queue', 'path')}"
  puts "  Frozen manifests: #{plan.dig('queue', 'manifest_count')}"
  puts format("  Aggregate hourly ceiling: $%.4f/hr", plan.dig("capacity", "max_total_hourly_usd"))
  puts "  Budget ID: #{plan.dig('budget', 'budget_id')}"
  puts format("  Cumulative compute ceiling: $%.4f", plan.dig("budget", "max_cumulative_compute_usd"))
  puts format("  Maximum runtime: %.1fs", plan.dig("budget", "max_runtime_seconds"))
  plan.fetch("pools").each do |pool|
    capacity = pool.fetch("capacity")
    puts format(
      "  %-10s jobs=%-4d workers=%d/%d max=$%.4f/hr model=%s",
      pool.fetch("pool_id"),
      pool.fetch("job_count"),
      capacity.fetch("minimum_workers"),
      capacity.fetch("desired_workers"),
      capacity.fetch("max_pool_hourly_usd"),
      pool.dig("requirements", "ollama_model")
    )
  end
  puts "  Plan: #{output_path}"
  puts "  Hardware/provider selection is intentionally absent; RPOF owns fulfillment mechanics."
rescue ProductionExecutionPoolPlan::Error => e
  warn "ERROR: #{e.message}"
  exit 1
end
