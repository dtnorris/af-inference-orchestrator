#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/production_burst_status"

ROOT = File.expand_path(ENV.fetch("LME_REPO", File.expand_path("..", __dir__)))

ledger_arg = ARGV.shift or abort "Usage: bin/lme-production-burst-status PATH/production-burst.json"
abort "Usage: bin/lme-production-burst-status PATH/production-burst.json" unless ARGV.empty?

begin
  $stdout.write(ProductionBurstStatus.new(root: ROOT).render(ledger_arg))
  exit 0
rescue JSON::ParserError, KeyError, RuntimeError, SystemCallError, ArgumentError, TypeError => e
  warn "ERROR: #{e.message}"
  exit 1
end
