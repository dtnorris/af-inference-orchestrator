#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "local_model_evaluation"
require "fileutils"
require "json"
require "optparse"
require "rbconfig"

ROOT = File.expand_path("..", __dir__)
ENV["LME_REPO"] = ROOT

def selected_fleet_key
  ENV.fetch("LME_RUNPOD_FLEET", LocalModelEvaluation::RunpodFleetNamespace::DEFAULT_KEY)
end

def runpod_namespace(fleet_key = selected_fleet_key, create: false, provisional: false)
  LocalModelEvaluation::RunpodFleetNamespace.new(
    root: File.join(ROOT, "output", "runpod-fleets"),
    repo_root: ROOT,
    fleet_key:,
    create:,
    provisional:
  )
end

def apply_selected_runpod_routing!(require_active: false)
  fleet_key = selected_fleet_key
  namespace = runpod_namespace(fleet_key)
  state = LocalModelEvaluation::RunpodFleetState.new(
    root: namespace.state_root,
    local_port_base: namespace.local_port_base
  )
  fleet = state.current
  unless fleet && fleet["status"] == "active"
    abort "RunPod fleet #{fleet_key.inspect} is not active; provision/select the intended fleet first." if require_active
    return
  end

  fleet.fetch("workers").each do |worker|
    next unless worker["status"] == "active"

    ENV["LME_BURST_#{Integer(worker.fetch('index'))}_URL"] = worker.fetch("local_ollama_url")
  end
rescue LocalModelEvaluation::RunpodFleetNamespace::Error => e
  abort "RunPod fleet #{fleet_key.inspect}: #{e.message}" if require_active
end

def load_workers(require_runpod: false)
  apply_selected_runpod_routing!(require_active: require_runpod)
  path = ENV["LME_WORKERS_CONFIG"].to_s.strip
  path = File.join(ROOT, "config", "workers.yml") if path.empty?
  path = File.expand_path(path)
  abort "Missing #{path}; copy config/workers.example.yml first." unless File.file?(path)
  data = LocalModelEvaluation::Config.load_yaml(path)
  (data.fetch("workers")).to_h { |name, attrs| [name.to_s, LocalModelEvaluation::Worker.new(name, attrs)] }
end

def load_models
  data = LocalModelEvaluation::Config.load_yaml(File.join(ROOT, "config", "models.yml"))
  data.fetch("models").transform_keys(&:to_s)
end

def load_experiment_context(experiment_path, require_runpod: false)
  exp = LocalModelEvaluation::Experiment.new(experiment_path)
  managed = LocalModelEvaluation::RunpodReady.applicable?(exp)
  workers = load_workers(require_runpod: require_runpod && managed)
  models = load_models
  scheduler = LocalModelEvaluation::Scheduler.new(experiment: exp, workers:, models:)
  [exp, workers, models, scheduler.jobs]
end

def output_dir_for(exp)
  File.join(ROOT, "output", exp.name)
end

def parse_run_options(argv)
  opts = { rerun_failed: false, force: false }
  OptionParser.new do |o|
    o.on("--rerun-failed") { opts[:rerun_failed] = true }
    o.on("--force") { opts[:force] = true }
  end.parse!(argv)
  opts
end

def forwarded_run_options(opts)
  args = []
  args << "--rerun-failed" if opts[:rerun_failed]
  args << "--force" if opts[:force]
  args
end

def runpod_api_key
  key = ENV["RUNPOD_API_KEY"].to_s
  abort "RUNPOD_API_KEY is missing; add it to the repo-local .env file." if key.empty?
  key
end

def runpod_client
  LocalModelEvaluation::RunpodClient.new(
    api_key: runpod_api_key,
    base_url: ENV.fetch("RUNPOD_API_BASE_URL", LocalModelEvaluation::RunpodClient::DEFAULT_BASE_URL)
  )
end

def runpod_fleet(client = runpod_client, namespace: nil, create_namespace: false, provisional_namespace: false)
  namespace ||= runpod_namespace(
    selected_fleet_key,
    create: create_namespace,
    provisional: provisional_namespace
  )
  LocalModelEvaluation::RunpodFleet.new(
    client:,
    env_path: namespace.env_path,
    state_root: namespace.state_root,
    fleet_key: namespace.fleet_key,
    local_port_base: namespace.local_port_base
  )
end

def start_runpod_lease_watchdog!(namespace:, fleet:, workers:)
  record = fleet.fleet_state.current
  return nil unless record && record["lease"]

  lease_dir = fleet.fleet_state.artifact_dir(record.fetch("fleet_id"), "lease")
  FileUtils.mkdir_p(lease_dir)
  log_path = File.join(lease_dir, LocalModelEvaluation::RunpodLease::LOG_FILE)
  log = File.open(log_path, "a")
  command = [
    RbConfig.ruby,
    File.join(ROOT, "bin", "lme-runpod-lease"),
    "watch",
    "--fleet", namespace.fleet_key,
    "--expected-fleet-id", record.fetch("fleet_id")
  ]
  pid = Process.spawn(*command, chdir: ROOT, in: File::NULL, out: log, err: [:child, :out], pgroup: true)
  Process.detach(pid)
  puts "Lease watchdog: pid #{pid}; log #{log_path}"
  pid
rescue SystemCallError => e
  teardown_error = nil
  begin
    fleet.destroy(worker_indices: workers.map(&:index))
  rescue StandardError => destroy_error
    teardown_error = destroy_error
  end
  detail = teardown_error ? "; emergency teardown also failed: #{teardown_error.message}" : "; newly-created fleet was torn down"
  raise LocalModelEvaluation::RunpodFleet::Error, "could not start lease watchdog: #{e.message}#{detail}"
ensure
  log&.close
end

def build_runpod_readiness(experiment, workers, models)
  namespace = runpod_namespace
  fleet_state = LocalModelEvaluation::RunpodFleetState.new(
    root: namespace.state_root,
    local_port_base: namespace.local_port_base
  )
  client = ENV["RUNPOD_API_KEY"].to_s.empty? ? nil : runpod_client
  gate = LocalModelEvaluation::RunpodReady.new(
    fleet_state:,
    client:,
    tunnels: LocalModelEvaluation::RunpodTunnels.new(
      fleet_state:,
      repo_root: ROOT
    ),
    worker_check: LocalModelEvaluation::WorkerCheck.new
  )
  [gate, gate.check(experiment:, workers:, models:)]
end

def confirm_or_abort(prompt, assume_yes: false)
  return if assume_yes

  $stdout.print "#{prompt} [y/N] "
  $stdout.flush
  answer = $stdin.gets.to_s.strip.downcase
  abort "Aborted; no changes made." unless %w[y yes].include?(answer)
end

def parse_worker_indices(value)
  LocalModelEvaluation::RunpodWorkers.parse_selector(value)
rescue LocalModelEvaluation::RunpodWorkers::Error => e
  abort e.message
end

def extract_fleet_option!(argv)
  fleet = nil
  index = 0
  while index < argv.length
    token = argv[index]
    if token == "--fleet"
      abort "--fleet requires a key" if index + 1 >= argv.length
      fleet = argv[index + 1]
      argv.slice!(index, 2)
    elsif token.start_with?("--fleet=")
      fleet = token.split("=", 2).last
      argv.delete_at(index)
    else
      index += 1
    end
  end
  fleet
end

def runpod_create_options(argv)
  opts = {
    workers: nil,
    cloud: LocalModelEvaluation::RunpodFleet::DEFAULT_CLOUD,
    container_disk_gb: LocalModelEvaluation::RunpodFleet::DEFAULT_CONTAINER_DISK_GB,
    volume_gb: LocalModelEvaluation::RunpodFleet::DEFAULT_VOLUME_GB,
    max_runtime_seconds: nil,
    max_spend_usd: nil,
    dry_run: false,
    yes: false,
    max_hourly_usd: ENV.fetch("RUNPOD_MAX_FLEET_HOURLY_USD", LocalModelEvaluation::RunpodFleet::DEFAULT_MAX_FLEET_HOURLY_USD),
    max_total_hourly_usd: ENV.fetch("RUNPOD_MAX_TOTAL_HOURLY_USD", LocalModelEvaluation::RunpodFleetNamespace::DEFAULT_MAX_TOTAL_HOURLY_USD),
    ssh_public_key: ENV.fetch("RUNPOD_SSH_PUBLIC_KEY_PATH", "~/.ssh/id_ed25519.pub"),
    wait_seconds: LocalModelEvaluation::RunpodFleet::DEFAULT_WAIT_SECONDS,
    poll_seconds: LocalModelEvaluation::RunpodFleet::DEFAULT_POLL_SECONDS
  }
  OptionParser.new do |o|
    o.on("--workers N", Integer, "Number of burst workers (1-16)") { |v| opts[:workers] = v }
    o.on("--cloud TIER", "RunPod cloud tier: COMMUNITY or SECURE (default: COMMUNITY)") { |v| opts[:cloud] = v }
    o.on("--container-disk-gb N", Integer, "Container/root disk size in GB") { |v| opts[:container_disk_gb] = v }
    o.on("--volume-gb N", Integer, "Persistent /workspace volume size in GB") { |v| opts[:volume_gb] = v }
    o.on("--max-runtime-minutes MINUTES", Float, "Destroy the fleet after this many minutes") { |v| opts[:max_runtime_seconds] = v * 60.0 }
    o.on("--max-spend-usd USD", Float, "Destroy the fleet when conservative tracked spend reaches USD") { |v| opts[:max_spend_usd] = v }
    o.on("--dry-run", "Read-only availability/cost/prerequisite check") { opts[:dry_run] = true }
    o.on("--yes", "Skip the paid-create confirmation prompt") { opts[:yes] = true }
    o.on("--max-hourly-usd USD", Float, "Fail closed above this fleet's hourly rate") { |v| opts[:max_hourly_usd] = v }
    o.on("--max-total-hourly-usd USD", Float, "Fail closed above aggregate managed RunPod hourly rate") { |v| opts[:max_total_hourly_usd] = v }
    o.on("--ssh-public-key PATH", "OpenSSH public key file to authorize") { |v| opts[:ssh_public_key] = v }
    o.on("--wait-seconds N", Integer, "Maximum provisioning wait") { |v| opts[:wait_seconds] = v }
    o.on("--poll-seconds N", Float, "Provisioning poll interval") { |v| opts[:poll_seconds] = v }
  end.parse!(argv)
  abort "Usage: bin/lme runpod-create --workers N [--dry-run|--yes]" unless opts[:workers]
  opts
end

def runpod_destroy_options(argv)
  opts = { workers: nil, all: false, yes: false }
  OptionParser.new do |o|
    o.on("--workers LIST", "Burst worker indices, e.g. 1-12 or 1,6,12") { |v| opts[:workers] = parse_worker_indices(v) }
    o.on("--all", "Select every active worker in the current fleet") { opts[:all] = true }
    o.on("--yes", "Skip the destructive confirmation prompt") { opts[:yes] = true }
  end.parse!(argv)
  abort "use either --workers or --all, not both" if opts[:workers] && opts[:all]
  abort "Usage: bin/lme runpod-destroy (--workers LIST|--all) [--yes]" unless opts[:workers] || opts[:all]
  opts
end

command = ARGV.shift
begin
  fleet_option = extract_fleet_option!(ARGV)
  ENV["LME_RUNPOD_FLEET"] = LocalModelEvaluation::RunpodFleetNamespace.normalize_key(fleet_option) if fleet_option
rescue LocalModelEvaluation::RunpodFleetNamespace::Error => e
  warn "ERROR: #{e.message}"
  exit 2
end

case command
when "plan"
  experiment_path = ARGV.shift or abort "Usage: bin/lme plan EXPERIMENT.yml"
  exp, workers, _models, jobs = load_experiment_context(experiment_path)
  puts "Experiment: #{exp.name}"
  puts "Purpose: #{exp.purpose}" unless exp.purpose.empty?
  puts "Dispatch: #{exp.dispatch}"
  puts "Models: #{exp.models.join(', ')}"
  puts "Adventures: #{exp.adventures.length}"
  puts "Replicates: #{exp.replicates}"
  puts "Workers: #{exp.worker_names.join(', ')}"
  puts "Jobs: #{jobs.length}"
  puts "Cost cap: #{format('$%.2f', exp.cost_cap_usd)} (soft scoring-runtime stop)" if exp.cost_cap_usd
  exp.worker_names.each do |name|
    w = workers.fetch(name)
    puts "  - #{name}: #{format('$%.4f/hr', w.hourly_rate_usd)} #{w.labels.empty? ? '' : '[' + w.labels.join(', ') + ']'}"
  end

when "worker-check"
  experiment_path = ARGV.shift
  workers = load_workers
  models = load_models
  selected = workers.values
  required_models = []
  required_labels = []
  if experiment_path
    exp = LocalModelEvaluation::Experiment.new(experiment_path)
    selected = exp.worker_names.map { |name| workers.fetch(name) }
    required_models = exp.models.map { |name| models.fetch(name).fetch("ollama_model") }
    required_labels = exp.required_worker_labels
  end

  checker = LocalModelEvaluation::WorkerCheck.new
  failed = false
  puts format("%-14s %-11s %-12s %s", "WORKER", "STATUS", "OLLAMA", "REQUIREMENTS")
  selected.each do |worker|
    result = checker.check(worker, required_models:, required_labels:)
    if result.error
      failed = true
      puts format("%-14s %-11s %-12s %s", worker.name, "ERROR", "-", result.error)
    elsif result.missing_labels.any?
      failed = true
      puts format("%-14s %-11s %-12s %s", worker.name, "INELIGIBLE", result.version || "?", "missing labels: #{result.missing_labels.join(', ')}")
    elsif result.missing_models.any?
      failed = true
      puts format("%-14s %-11s %-12s %s", worker.name, "MISSING", result.version || "?", "missing models: #{result.missing_models.join(', ')}")
    else
      requirement_text = required_models.empty? && required_labels.empty? ? "-" : "yes"
      puts format("%-14s %-11s %-12s %s", worker.name, "OK", result.version || "?", requirement_text)
    end
  end
  exit(failed ? 1 : 0)

when "runpod-ready"
  experiment_path = ARGV.shift or abort "Usage: bin/lme runpod-ready EXPERIMENT.yml [--fleet KEY]"
  abort "Usage: bin/lme runpod-ready EXPERIMENT.yml [--fleet KEY]" unless ARGV.empty?
  exp, workers, models, _jobs = load_experiment_context(experiment_path, require_runpod: true)
  unless LocalModelEvaluation::RunpodReady.applicable?(exp)
    puts "RunPod readiness: NOT APPLICABLE -- experiment has no managed burst_N workers."
    exit 0
  end
  gate, readiness = build_runpod_readiness(exp, workers, models)
  puts gate.render(readiness)
  if readiness.fetch("ready")
    puts "Next: bin/lme run #{experiment_path}"
    exit 0
  end
  exit 1

when "runpod-tunnels"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-tunnels"), *ARGV

when "runpod-status"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-status"), *ARGV

when "runpod-lease"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lease"), *ARGV

when "runpod-scale"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lifecycle"), "scale", *ARGV

when "runpod-replace"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-lifecycle"), "replace", *ARGV

when "runpod-bootstrap"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-bootstrap"), *ARGV

when "runpod-dispatch"
  exec RbConfig.ruby, File.join(ROOT, "bin", "lme-runpod-dispatch"), *ARGV

when "runpod-create"
  opts = runpod_create_options(ARGV)
  fleet_key = selected_fleet_key
  begin
    namespace = runpod_namespace(fleet_key, provisional: true)
    fleet = runpod_fleet(namespace:)
    preflight = fleet.preflight(
      worker_count: opts[:workers],
      cloud: opts[:cloud],
      max_fleet_hourly_usd: opts[:max_hourly_usd],
      container_disk_gb: opts[:container_disk_gb],
      volume_gb: opts[:volume_gb],
      max_runtime_seconds: opts[:max_runtime_seconds],
      max_spend_usd: opts[:max_spend_usd]
    )
    ssh_public_key = fleet.read_ssh_public_key(opts[:ssh_public_key])
    current_total_rate = namespace.total_active_hourly_usd
    projected_total_rate = current_total_rate + preflight.fleet_hourly_rate
    begin
      max_total_rate = Float(opts[:max_total_hourly_usd])
      raise ArgumentError unless max_total_rate.positive?
    rescue ArgumentError, TypeError
      raise LocalModelEvaluation::RunpodFleet::Error, "aggregate managed RunPod hourly safety cap must be a positive number"
    end
    if projected_total_rate > max_total_rate
      raise LocalModelEvaluation::RunpodFleet::Error, format(
        "projected managed RunPod total $%.4f/hr exceeds aggregate safety cap $%.4f/hr; no pods were created",
        projected_total_rate,
        max_total_rate
      )
    end

    puts "RunPod fleet preflight"
    puts "  Fleet: #{namespace.fleet_key}"
    puts "  GPU: #{preflight.gpu.fetch('id')} (#{preflight.gpu.fetch('memory')} GB VRAM)"
    puts "  Cloud: #{preflight.cloud}"
    puts "  Availability: #{preflight.availability}"
    puts "  Workers: #{preflight.worker_count}"
    puts "  Container disk: #{preflight.container_disk_gb} GB"
    puts "  Workspace volume: #{preflight.volume_gb} GB at #{LocalModelEvaluation::RunpodFleet::VOLUME_MOUNT_PATH}"
    puts format("  Catalog rate: $%.4f/hr per worker", preflight.hourly_rate)
    puts format("  Projected fleet rate: $%.4f/hr", preflight.fleet_hourly_rate)
    puts format("  Projected 10-minute cost: $%.4f", preflight.fleet_hourly_rate / 6.0)
    puts format("  Projected 30-minute cost: $%.4f", preflight.fleet_hourly_rate / 2.0)
    puts format("  Per-fleet safety cap: $%.4f/hr", preflight.max_fleet_hourly_rate)
    puts format("  Existing managed fleets: $%.4f/hr", current_total_rate)
    puts format("  Projected managed total: $%.4f/hr", projected_total_rate)
    puts format("  Aggregate safety cap: $%.4f/hr", max_total_rate)
    if preflight.max_runtime_seconds
      puts format("  Runtime lease: %.1f minutes", preflight.max_runtime_seconds / 60.0)
    end
    if preflight.max_spend_usd
      puts format("  Spend lease: $%.4f", preflight.max_spend_usd)
    end
    if preflight.max_runtime_seconds || preflight.max_spend_usd
      puts "  Lease enforcement: local detached watchdog after fleet activation"
    end
    puts "  SSH public key: #{File.expand_path(opts[:ssh_public_key])}"
    puts "No pods have been created."

    if opts[:dry_run]
      puts "Dry run PASS."
      exit 0
    end

    confirm_or_abort(
      format(
        "Create %d paid RunPod %s worker(s) in fleet %s at $%.4f/hr (projected managed total $%.4f/hr)?",
        preflight.worker_count,
        preflight.cloud,
        fleet_key,
        preflight.fleet_hourly_rate,
        projected_total_rate
      ),
      assume_yes: opts[:yes]
    )

    namespace = runpod_namespace(fleet_key, create: true)
    fleet = runpod_fleet(namespace:)
    workers = fleet.create(
      worker_count: opts[:workers],
      cloud: opts[:cloud],
      ssh_public_key:,
      preflight:,
      max_fleet_hourly_usd: opts[:max_hourly_usd],
      container_disk_gb: opts[:container_disk_gb],
      volume_gb: opts[:volume_gb],
      max_runtime_seconds: opts[:max_runtime_seconds],
      max_spend_usd: opts[:max_spend_usd],
      wait_seconds: opts[:wait_seconds],
      poll_seconds: opts[:poll_seconds]
    )
    start_runpod_lease_watchdog!(namespace:, fleet:, workers:)
    actual_rate = workers.sum(&:hourly_rate)
    puts "RunPod fleet ready:"
    workers.each do |worker|
      puts format(
        "  burst_%d: pod=%s ssh=%s:%d $%.4f/hr",
        worker.index,
        worker.pod_id,
        worker.host,
        worker.ssh_port,
        worker.hourly_rate
      )
    end
    puts format("Actual fleet rate: $%.4f/hr", actual_rate)
    puts "Provisioning stopped here: no Ollama bootstrap, tunnels, worker-check, or scoring were started."
  rescue LocalModelEvaluation::RunpodClient::Error,
         LocalModelEvaluation::RunpodFleet::Error,
         LocalModelEvaluation::RunpodFleetNamespace::Error => e
    warn "ERROR: #{e.message}"
    exit 1
  end

when "runpod-destroy"
  opts = runpod_destroy_options(ARGV)
  fleet_key = selected_fleet_key
  begin
    namespace = runpod_namespace(fleet_key)
  rescue LocalModelEvaluation::RunpodFleetNamespace::Error => e
    warn "ERROR: #{e.message}"
    exit 1
  end
  if opts[:all]
    begin
      current = LocalModelEvaluation::RunpodFleetState.new(
        root: namespace.state_root,
        local_port_base: namespace.local_port_base
      ).current
      raise LocalModelEvaluation::RunpodFleet::Error, "no active workers exist in fleet #{fleet_key}" unless current && current["status"] == "active"

      opts[:workers] = current.fetch("workers").filter_map do |worker|
        Integer(worker.fetch("index")) if worker["status"] == "active"
      end
      raise LocalModelEvaluation::RunpodFleet::Error, "no active workers exist in fleet #{fleet_key}" if opts[:workers].empty?
    rescue LocalModelEvaluation::RunpodFleetState::Error, KeyError, ArgumentError, TypeError,
           LocalModelEvaluation::RunpodFleet::Error => e
      warn "ERROR: #{e.message}"
      exit 1
    end
  end
  confirm_or_abort(
    "Permanently delete RunPod fleet #{fleet_key} worker(s): #{opts[:workers].map { |index| "burst_#{index}" }.join(', ')}?",
    assume_yes: opts[:yes]
  )

  begin
    tunnel_state = LocalModelEvaluation::RunpodFleetState.new(
      root: namespace.state_root,
      local_port_base: namespace.local_port_base
    )
    current = tunnel_state.current
    if current
      active_indices = current.fetch("workers").filter_map do |worker|
        index = Integer(worker.fetch("index"))
        index if worker["status"] == "active" && opts[:workers].include?(index)
      end
      unless active_indices.empty?
        tunnel_root = tunnel_state.artifact_dir(current.fetch("fleet_id"), "tunnels")
        if File.file?(File.join(tunnel_root, LocalModelEvaluation::RunpodTunnels::STATE_FILE))
          LocalModelEvaluation::RunpodTunnels.new(
            fleet_state: tunnel_state,
            repo_root: ROOT
          ).stop(worker_indices: active_indices)
        end
      end
    end
  rescue LocalModelEvaluation::RunpodFleetState::Error, LocalModelEvaluation::RunpodTunnels::Error => e
    warn "WARNING: could not stop managed local tunnel(s): #{e.message}; continuing paid pod teardown."
  end

  begin
    cleared = runpod_fleet(namespace: namespace).destroy(worker_indices: opts[:workers])
    puts "RunPod teardown complete for fleet #{fleet_key}: #{cleared.map { |index| "burst_#{index}" }.join(', ')}"
  rescue LocalModelEvaluation::RunpodClient::Error,
         LocalModelEvaluation::RunpodFleet::Error,
         LocalModelEvaluation::RunpodFleetNamespace::Error => e
    warn "ERROR: #{e.message}"
    exit 1
  end

when "start"
  experiment_path = ARGV.shift or abort "Usage: bin/lme start EXPERIMENT.yml [--rerun-failed|--force]"
  opts = parse_run_options(ARGV)
  exp, _workers, _models, jobs = load_experiment_context(experiment_path)
  output_dir = output_dir_for(exp)
  status = LocalModelEvaluation::RunStatus.new(output_dir:, jobs:)
  abort "Experiment manager is already running (pid #{status.manager_pid})." if status.manager_running?

  FileUtils.mkdir_p(output_dir)
  log_path = File.join(output_dir, "manager.log")
  pid_path = File.join(output_dir, "manager.pid")
  child_command = [RbConfig.ruby, File.expand_path(__FILE__), "run", File.expand_path(experiment_path), *forwarded_run_options(opts)]

  log = File.open(log_path, "a")
  pid = Process.spawn(*child_command, chdir: ROOT, in: File::NULL, out: log, err: [:child, :out], pgroup: true)
  Process.detach(pid)
  log.close
  File.write(pid_path, "#{pid}\n")

  puts "Started: #{exp.name}"
  puts "Manager PID: #{pid}"
  puts "Jobs: #{jobs.length}"
  puts "Status: bin/lme status #{experiment_path}"
  puts "Log: #{log_path}"

when "status"
  experiment_path = ARGV.shift or abort "Usage: bin/lme status EXPERIMENT.yml"
  exp, _workers, _models, jobs = load_experiment_context(experiment_path)
  status = LocalModelEvaluation::RunStatus.new(output_dir: output_dir_for(exp), jobs:)
  counts = status.counts
  manager = if status.manager_running?
              "running (pid #{status.manager_pid})"
            elsif status.manager_pid
              "stopped (stale pid #{status.manager_pid})"
            else
              "not started"
            end

  puts "Experiment: #{exp.name}"
  puts "Manager: #{manager}"
  puts "Jobs: #{jobs.length} total; #{counts['complete']} complete; #{counts['failed']} failed; #{counts['running']} running; #{counts['pending']} pending; #{counts['unknown']} unknown"
  puts format("Estimated scoring-runtime cost: $%.4f", status.estimated_cost_usd)
  puts "Report: #{File.join(output_dir_for(exp), 'summary.md')}" if File.file?(File.join(output_dir_for(exp), "summary.md"))
  puts "Log: #{File.join(output_dir_for(exp), 'manager.log')}" if File.file?(File.join(output_dir_for(exp), "manager.log"))

when "run"
  experiment_path = ARGV.shift or abort "Usage: bin/lme run EXPERIMENT.yml [--rerun-failed|--force]"
  opts = parse_run_options(ARGV)

  exp, workers, models, jobs = load_experiment_context(experiment_path, require_runpod: true)
  if LocalModelEvaluation::RunpodReady.applicable?(exp)
    gate, readiness = build_runpod_readiness(exp, workers, models)
    puts gate.render(readiness)
    unless readiness.fetch("ready")
      warn "ERROR: RunPod readiness gate failed; no scoring was started."
      exit 1
    end
  end

  puts "Experiment: #{exp.name}"
  puts "Dispatch: #{exp.dispatch}"
  puts "Jobs: #{jobs.length}"
  runner = LocalModelEvaluation::Runner.new(experiment: exp, workers:, models:, output_root: File.join(ROOT, "output"), **opts)
  runner.run(jobs)
  LocalModelEvaluation::Reporter.new(runner.output_dir).write
  puts "Report: #{File.join(runner.output_dir, 'summary.md')}"

when "report"
  output = ARGV.shift or abort "Usage: bin/lme report OUTPUT_DIR"
  LocalModelEvaluation::Reporter.new(output).write
  puts "Report: #{File.join(File.expand_path(output), 'summary.md')}"

else
  warn <<~USAGE
    Usage:
      bin/lme plan EXPERIMENT.yml
      bin/lme worker-check [EXPERIMENT.yml]
      bin/lme runpod-ready EXPERIMENT.yml [--fleet KEY]
      bin/lme runpod-status [--fleet KEY]
      bin/lme runpod-lease [status|watch] [--fleet KEY] [--expected-fleet-id ID] [--poll-seconds N]
      bin/lme runpod-scale --workers N [--fleet KEY] [--dry-run|--yes] [--max-hourly-usd USD] [--max-total-hourly-usd USD]
      bin/lme runpod-replace --worker N [--fleet KEY] [--dry-run|--yes] [--max-hourly-usd USD] [--max-total-hourly-usd USD]
      bin/lme runpod-tunnels [start|status|stop] [--workers 1-16|--all] [--fleet KEY]
      bin/lme runpod-bootstrap --workers 1-16 --model MODEL [options] [--fleet KEY]
      bin/lme runpod-dispatch --jobs FILE (--workers LIST|--all) --output DIR [--group-by-affinity] [--fleet KEY]
      bin/lme runpod-create --workers N [--fleet KEY] [--cloud COMMUNITY|SECURE] [--container-disk-gb N] [--volume-gb N] [--max-runtime-minutes MINUTES] [--max-spend-usd USD] [--dry-run|--yes] [--max-hourly-usd USD] [--max-total-hourly-usd USD]
      bin/lme runpod-destroy (--workers 1-16|--all) [--fleet KEY] [--yes]
      bin/lme start EXPERIMENT.yml [--fleet KEY] [--rerun-failed|--force]
      bin/lme status EXPERIMENT.yml [--fleet KEY]
      bin/lme run EXPERIMENT.yml [--fleet KEY] [--rerun-failed|--force]
      bin/lme report OUTPUT_DIR
  USAGE
  exit 1
end
